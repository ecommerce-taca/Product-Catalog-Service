# ==============================================================================
# PRODUCT CATALOG SERVICE - LOCAL ENVIRONMENT CONFIGURATION
# Copy file này thành .env để chạy ứng dụng trực tiếp trên máy host
# ==============================================================================

# Application
PORT=3000
GLOBAL_PREFIX=api/v1
NODE_ENV=development

# MongoDB Replica Set (Kết nối tới container MongoDB qua cổng 27017 trên máy host)
MONGODB_URI=mongodb://localhost:27017/product_catalog?replicaSet=rs0
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=20
MONGODB_SOCKET_TIMEOUT_MS=30000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_READ_PREFERENCE=primaryPreferred

# MinIO / S3 Object Storage (Kết nối tới container MinIO qua cổng 9000 trên máy host)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=taca-product-media-prod
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_PUBLIC_URL=http://localhost:9000
AWS_S3_FORCE_PATH_STYLE=true
MEDIA_SIGNED_URL_TTL=600

# Apache Kafka Broker (Kết nối tới container Kafka qua cổng 9092 trên máy host)
KAFKA_BROKERS=localhost:9092
